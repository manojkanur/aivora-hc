# ============================================================
# Aivora HC Backend – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aivora_hc

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string-do-not-use-in-production
APP_SECRET_KEY=replace-with-another-random-64-char-hex-string

# Fernet key – generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-fernet-generated-key-e.g.-Zm9vYmFyYmF6cXV4Zm9v...

# ---- Clerk Auth ----
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_JWT_ISSUER=https://clerk.your-domain.com

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe Price IDs – create these in your Stripe dashboard
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_STARTER_ANNUAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_ADVISORY_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ADVISORY_ANNUAL=price_xxxxxxxxxxxxx

# Credit topup price IDs (one-time payments)
STRIPE_PRICE_TOPUP_50=price_xxxxxxxxxxxxx
STRIPE_PRICE_TOPUP_200=price_xxxxxxxxxxxxx
STRIPE_PRICE_TOPUP_500=price_xxxxxxxxxxxxx

# ---- Anthropic AI ----
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
AI_MODEL=claude-opus-4-7-20250514

# ---- AWS S3 ----
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=aivora-hc-exports

# ---- LinkedIn OAuth ----
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://your-domain.com/api/v1/oauth/linkedin/callback

# ---- Sentry (optional) ----
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ---- App ----
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
